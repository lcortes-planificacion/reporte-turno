.firma-canvas {
  touch-action: none;
  width: 100%;
  height: 140px;
  display: block;
  background: var(--surface-sunk);
  border: 1.5px dashed #C7CDD3;
  border-radius: 8px;
}

.firma-canvas.firmada {
  border-style: solid;
  border-color: var(--ok);
}

.banner-offline {
  position: sticky;
  top: 0;
  z-index: 40;
  padding-top: var(--sat);
}
